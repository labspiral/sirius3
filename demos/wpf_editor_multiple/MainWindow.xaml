<Window x:Class="Demos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:SpiralLab.Sirius3.UI.WPF;assembly=SpiralLab.Sirius3.UI"
        Title="Sirius3 WPF Multiple Editors Demo - (c)SpiralLAB"
        Width="1500" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource SiriusMaterialWindow}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        Closed="MainWindow_Closed">
  <Grid Background="{DynamicResource Sirius.Brush.Window}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Keep both GL controls attached while switching editors. TabControl content
         replacement unloads and reloads GLWpfControl on every selection. -->
    <TabControl x:Name="editorTabs" Grid.Row="0" Height="34" SelectionChanged="EditorTabs_SelectionChanged">
      <TabItem Header="EDITOR 1" />
      <TabItem Header="EDITOR 2" />
    </TabControl>
    <Grid Grid.Row="1">
      <wpf:SiriusEditorControl x:Name="editor1" AliasName="Editor 1" />
      <wpf:SiriusEditorControl x:Name="editor2" AliasName="Editor 2" Visibility="Collapsed" />
    </Grid>
  </Grid>
</Window>
