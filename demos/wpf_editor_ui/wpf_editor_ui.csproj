<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net481;net8.0-windows;net9.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Demos</RootNamespace>
	<OutputPath>..\..\bin\</OutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <IncludeSymbols>False</IncludeSymbols>
    <NeutralResourcesLanguage>en-US</NeutralResourcesLanguage>
    <SatelliteResourceLanguages>ko-KR;zh-CN;ja-JP;de-DE</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>


	<PropertyGroup Condition="'$(TargetFramework)'=='net481'">
		<DefineConstants>$(DefineConstants);OPENTK3</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)'!='net481'">
		<DefineConstants>$(DefineConstants);OPENTK4</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net481'">
		<Reference Include="System.Drawing" />
		<PackageReference Include="OpenTK" Version="3.3.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'!='net481'">
		<PackageReference Include="OpenTK" Version="4.9.4" />
		<PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
	</ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Compile Include="..\helper.cs" Link="helper.cs" />
    <Compile Include="..\nativemethods.cs" Link="nativemethods.cs" />
    <Resource Include="Resources\File new.png" />
    <Resource Include="Resources\Import Import.png" />
    <Resource Include="Resources\Save as.png" />
    <None Include="..\config.ini" Link="config.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

	<!-- For all targets -->

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
		<PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SpiralLab.Sirius3.Dependencies" Version="1.*" />
		<PackageReference Include="SpiralLab.Sirius3" Version="1.*" />
		<PackageReference Include="SpiralLab.Sirius3.UI" Version="1.*" />
	</ItemGroup>
</Project>
