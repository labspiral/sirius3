<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net481;net8.0-windows;net9.0-windows</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Demos</RootNamespace>
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<OutputPath>..\..\bin\</OutputPath>
		<IncludeSymbols>False</IncludeSymbols>
		<NeutralResourcesLanguage>en-US</NeutralResourcesLanguage>
		<SatelliteResourceLanguages>ko-KR;zh-CN;ja-JP;de-DE</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework.StartsWith(`net9.0-windows`))'">
		<WarningsNotAsErrors>$(WarningsNotAsErrors);WFO1000</WarningsNotAsErrors>
		<NoWarn>$(NoWarn);WFO1000</NoWarn>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net481'">
		<DefineConstants>$(DefineConstants);OPENTK3</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework.StartsWith(`net8.0-windows`))' OR '$(TargetFramework.StartsWith(`net9.0-windows`))'">
		<DefineConstants>$(DefineConstants);OPENTK4</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net481'">
		<PackageReference Include="OpenTK" Version="3.3.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework.StartsWith(`net8.0-windows`))' OR '$(TargetFramework.StartsWith(`net9.0-windows`))'">
		<PackageReference Include="OpenTK" Version="4.9.4" />
		<PackageReference Include="OpenTK.Mathematics" Version="4.9.4" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Include="..\helper.cs" Link="helper.cs" />
	  <Compile Include="..\nativemethods.cs" Link="nativemethods.cs" />
	</ItemGroup>
	
	<ItemGroup>
	  <None Include="..\config_syncaxis.ini" Link="config_syncaxis.ini">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>


	<!-- Optional RTC6 files for syncAXIS v1.8.2 x64. Uncomment this target when needed. -->
