	<!-- Optional RTC6 files for syncAXIS v1.8.2 x32. Uncomment this target when needed. -->
	<!--
	<Target Name="OverrideRTCFilesForSyncAXISx32" AfterTargets="Build">
		<Copy
			SourceFiles="$(TargetDir)syncaxis\bin\RTC6DLL.dll"
			DestinationFolder="$(TargetDir)x32\"
			OverwriteReadOnlyFiles="true" />
		<Copy
			SourceFiles="$(TargetDir)syncaxis\ProgramFiles\RTC6Dat.dat"
			DestinationFolder="$(TargetDir)"
			OverwriteReadOnlyFiles="true" />
		<Copy
			SourceFiles="$(TargetDir)syncaxis\ProgramFiles\RTC6Eth.out"
			DestinationFolder="$(TargetDir)"
			OverwriteReadOnlyFiles="true" />
		<Copy
			SourceFiles="$(TargetDir)syncaxis\ProgramFiles\RTC6Out.out"
			DestinationFolder="$(TargetDir)"
			OverwriteReadOnlyFiles="true" />
		<Copy
			SourceFiles="$(TargetDir)syncaxis\ProgramFiles\RTC6RBF.rbf"
			DestinationFolder="$(TargetDir)"
			OverwriteReadOnlyFiles="true" />
	</Target>
	-->

	<!-- copy syncAXIS files for x32 or x64. -->
	<PropertyGroup>
		<SyncAxisRuntimeFolder Condition="'$(PlatformTarget)' == 'x86'">x32</SyncAxisRuntimeFolder>
		<SyncAxisRuntimeFolder Condition="'$(PlatformTarget)' == 'x64'">x64</SyncAxisRuntimeFolder>
	</PropertyGroup>

	<Target Name="CopySyncAxisRuntimeFiles" AfterTargets="CopyFilesToOutputDirectory">
		<Error Condition="'$(SyncAxisRuntimeFolder)' == ''" Text="The syncAXIS demo must target x86 or x64 to select the matching runtime files." />
		<Error Condition="!Exists('$(TargetDir)$(SyncAxisRuntimeFolder)\syncAXIS.NET.dll')" Text="The $(SyncAxisRuntimeFolder) syncAXIS.NET.dll is missing from the SpiralLab.Sirius3.Dependencies package output." />
		<ItemGroup>
			<SyncAxisRuntimeFiles Include="$(TargetDir)$(SyncAxisRuntimeFolder)\syncAXIS*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(SyncAxisRuntimeFiles)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />
	</Target>
	

	<!-- For all targets -->

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SpiralLab.Sirius3.Dependencies" Version="1.*" />
		<PackageReference Include="SpiralLab.Sirius3" Version="1.*" />
		<PackageReference Include="SpiralLab.Sirius3.UI" Version="1.*" />
	</ItemGroup>
	
</Project>
