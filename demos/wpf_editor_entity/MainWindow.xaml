<local:Form x:Class="Demos.Form1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Demos"
        xmlns:wpf="clr-namespace:SpiralLab.Sirius3.UI.WPF;assembly=SpiralLab.Sirius3.UI"
        Title="Sirius3 WPF Entity Editor Demo - (c)SpiralLAB"
        Width="1500" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource SiriusMaterialWindow}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        Closed="MainWindow_Closed">
  <Grid Background="{DynamicResource Sirius.Brush.Window}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Sirius.Brush.Panel}"
            BorderBrush="{DynamicResource Sirius.Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="4">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    CanContentScroll="True">
        <StackPanel Orientation="Horizontal">
          <Button Margin="2,0" Content="Points" Click="Points_Click" />
          <Button Margin="2,0" Content="Line, Arc" Click="LineArc_Click" />
          <Button Margin="2,0" Content="Triangle, Rectangle" Click="TriangleRectangle_Click" />
          <Button Margin="2,0" Content="Polyline" Click="Polyline_Click" />
          <Button Margin="2,0" Content="Spline" Click="Spline_Click" />
          <Button Margin="2,0" Content="Text" Click="Text_Click" />
          <Button Margin="2,0" Content="Image" Click="Image_Click" />
          <Button Margin="2,0" Content="Grid Cloud" Click="GridCloud_Click" />
          <Button Margin="2,0" Content="Lines (Many)" Click="Lines_Click" />
          <Button Margin="2,0" Content="Barcode" Click="Barcode_Click" />
          <Button Margin="2,0" Content="Group" Click="Group_Click" />
          <Button Margin="2,0" Content="3D Mesh" Click="Mesh_Click" />
          <Button Margin="2,0" Content="Block, Insert" Click="BlockInsert_Click" />
          <Button Margin="2,0" Content="ZPL" Click="Zpl_Click" />
          <Button Margin="2,0" Content="Lissajous" Click="Lissajous_Click" />
          <Button Margin="2,0" Content="Spiral" Click="Spiral_Click" />
          <Button Margin="2,0" Content="Gerber" Click="Gerber_Click" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <wpf:SiriusEditorControl x:Name="siriusEditorControl1"
                             Grid.Row="1"
                             AliasName="WPF Entity Demo" />
  </Grid>
</local:Form>
