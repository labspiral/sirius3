<Window x:Class="Demos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:SpiralLab.Sirius3.UI.WPF;assembly=SpiralLab.Sirius3.UI"
        Title="Sirius3 WPF Multi-Device Editor Demo - (c)SpiralLAB"
        Width="1500" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource SiriusMaterialWindow}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        Closed="MainWindow_Closed">
  <Grid Background="{DynamicResource Sirius.Brush.Window}">
    <wpf:SiriusMultiEditorControl x:Name="multiEditor"
                                  AliasName="Multi-Device Editor"
                                  MaxDeviceCounts="2" />
  </Grid>
</Window>
